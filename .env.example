# ==========================================================
# Smart Agriculture Web Portal - Environment Variables
# ==========================================================

# Groq LLM API Key (used by server for Agronomy AI)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Configuration (Frontend & Backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server Port
PORT=5000
